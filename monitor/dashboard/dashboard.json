            "method": "GET"
          },
          "format": "table",
          "parser": "backend",
          "root_selector": "[repositories.($snapshot := $; $items := $exists(queue[0]) ? queue : [{}]; $items.{\"status\": $snapshot.current.status, \"reason\": $snapshot.current.reason, \"error\": $snapshot.last_error, \"observed\": $snapshot.last_observation_at, \"issue\": number, \"deadline\": $snapshot.queue_deadline, \"item_deadline\": deadline})]",
