    {
      "id": 6,
      "title": "24h 稼働率 / coverage",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 4,
        "h": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "monitor-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "agent_loop_monitor_demand_availability{repository=\"ishii1648/codex-issue-loop\",window=\"1d\"} and on() (up{job=\"agent-loop-monitor\"} == 1) and on() (time() - agent_loop_monitor_reference_time_seconds < 45)",
          "instant": true,
          "legendFormat": "稼働率"
        },
        {
          "refId": "B",
          "expr": "agent_loop_monitor_observation_coverage{repository=\"ishii1648/codex-issue-loop\",window=\"1d\"} and on() (up{job=\"agent-loop-monitor\"} == 1) and on() (time() - agent_loop_monitor_reference_time_seconds < 45)",
          "instant": true,
          "legendFormat": "coverage"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "UNKNOWN / データなし",
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "N/A（需要なし）",
                  "color": "text"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "coverage"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "orange",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "text": {
          "valueSize": 16,
          "titleSize": 12
        }
