{
  "uid": "independent-monitor",
  "title": "Independent agent-loop monitor",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "15s",
  "timezone": "utc",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 2,
      "title": "ishii1648/codex-issue-loop",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 2
      },
      "datasource": {
        "type": "prometheus",
        "uid": "monitor-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "agent_loop_monitor_state{repository=\"ishii1648/codex-issue-loop\"} and on() (up{job=\"agent-loop-monitor\"} == 1) and on() (time() - agent_loop_monitor_reference_time_seconds < 45)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "UNKNOWN / データなし",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "UNKNOWN",
                  "color": "#9CA3AF"
                },
                "1": {
                  "text": "HEALTHY",
                  "color": "#73BF69"
                },
                "2": {
                  "text": "DOWN",
                  "color": "#F2495C"
                },
                "3": {
                  "text": "IDLE",
                  "color": "#5794F2"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "text": {
          "valueSize": 16,
          "titleSize": 12
        }
      }
    },
    {
