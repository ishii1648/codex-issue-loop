    {
      "id": 12,
      "title": "状態タイムライン（選択期間）",
      "type": "state-timeline",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 3
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "monitor-history"
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "url": "http://127.0.0.1:19110/api/timeline?repo=ishii1648/codex-issue-loop&from=${__from:date:iso}&to=${__to:date:iso}",
          "url_options": {
            "method": "GET"
          },
          "format": "table",
          "parser": "backend",
          "root_selector": "repositories.`ishii1648/codex-issue-loop`",
          "columns": [
            {
              "selector": "started_at",
              "text": "開始",
              "type": "timestamp"
            },
            {
              "selector": "ended_at",
              "text": "終了",
              "type": "timestamp"
            },
            {
              "selector": "status",
              "text": "ishii1648/codex-issue-loop",
              "type": "string"
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "UNKNOWN": {
                  "text": "UNKNOWN",
                  "color": "#9CA3AF"
                },
                "HEALTHY": {
                  "text": "HEALTHY",
                  "color": "#73BF69"
                },
                "DOWN": {
                  "text": "DOWN",
                  "color": "#F2495C"
                },
                "IDLE": {
                  "text": "IDLE",
                  "color": "#5794F2"
                }
              }
            }
          ],
          "color": {
            "mode": "fixed",
            "fixedColor": "gray"
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": false,
        "showValue": "always",
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "開始": 0,
              "終了": 1,
              "ishii1648/codex-issue-loop": 2
            }
          }
        }
      ]
    },
    {
      "id": 13,
      "title": "DOWN理由・対象Issue / 最終取得時の詳細",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 3
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "monitor-history"
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "url": "http://127.0.0.1:19110/api/status?repo=ishii1648/codex-issue-loop",
          "url_options": {
            "method": "GET"
          },
          "format": "table",
          "parser": "backend",
          "root_selector": "[repositories.($snapshot := $; $items := $exists(queue[0]) ? queue : [{}]; $items.{\"status\": $snapshot.current.status, \"reason\": $snapshot.current.reason, \"error\": $snapshot.last_error, \"observed\": $snapshot.last_observation_at, \"issue\": number, \"deadline\": $snapshot.queue_deadline, \"item_deadline\": deadline})]",
          "columns": [
            {
              "selector": "status",
              "text": "状態",
              "type": "string"
            },
            {
              "selector": "reason",
              "text": "理由",
              "type": "string"
            },
            {
              "selector": "issue",
              "text": "Issue",
              "type": "number"
            },
            {
              "selector": "error",
              "text": "観測エラー",
              "type": "string"
            },
            {
              "selector": "observed",
              "text": "最終観測",
              "type": "timestamp"
            },
            {
              "selector": "deadline",
              "text": "queue期限",
              "type": "timestamp"
            },
            {
              "selector": "item_deadline",
              "text": "Issue期限",
              "type": "timestamp"
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "auto"
            },
            "wrapText": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Issue"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "GitHub Issue",
                    "url": "https://github.com/ishii1648/codex-issue-loop/issues/${__value.raw}",
                    "targetBlank": true
                  }
                ]
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "links": [
        {
          "title": "GitHub Issues",
          "url": "https://github.com/ishii1648/codex-issue-loop/issues"
        },
        {
          "title": "正確な区間JSON",
          "url": "http://127.0.0.1:19110/api/history?repo=ishii1648/codex-issue-loop&from=${__from:date:iso}&to=${__to:date:iso}"
        },
        {
          "title": "現在状態JSON",
          "url": "http://127.0.0.1:19110/api/status?repo=ishii1648/codex-issue-loop"
        }
      ]
    },
