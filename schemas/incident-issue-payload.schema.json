{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "codex-issue-loop incident Issue payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "episode_id", "fingerprint", "title", "body", "labels"],
  "properties": {
    "version": {"const": 1}, "episode_id": {"type": "string", "pattern": "^inc-[a-f0-9]{20}$"}, "fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 512}, "body": {"type": "string", "minLength": 1, "maxLength": 65536},
    "labels": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}}
  }
}
